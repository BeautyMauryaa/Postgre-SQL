# GROUP BY:

6.Find the total amount spent by each customer?
- SELECT customer_id, SUM(amount) FROM practorders GROUP BY customer_id,amount;

7. Find the number of orders placed by each customer.
- SELECT customer_id, COUNT(*) FROM practorders GROUP BY customer_id;

8. Find the average order amount for each customer.
-  SELECT customer_id, AVG(amount) FROM practorders GROUP BY customer_id;

9.Find the total revenue for each category.( it will be only completed order)
- SELECT customer_id, SUM(amount) FROM practorders AS total_revenue WHERE status='completed' GROUP BY customer_id,amount;


# WHERE + aggregation

Find the total completed-order amount for each customer.
- SELECT customer_id, SUM(amount) FROM practorders AS total_revenue WHERE status='completed' GROUP BY customer_id,amount;

12. Find the number of completed orders for each customer.
- SELECT customer_id, COUNT(status) 
FROM practorders 
AS completed_order
WHERE status='completed'
GROUP BY customer_id,status


13. Find customers whose total completed spending is greater than ₹20,000.
- SELECT customer_id, SUM(amount) 
FROM practorders 
AS  total_completed 
WHERE status='completed' AND amount>20000
GROUP BY customer_id,amount


14 .Find categories whose total revenue is greater than ₹20,000.
- SELECT customer_id, SUM(amount) 
FROM practorders 
AS  total_revenue
WHERE status='completed' 
GROUP BY customer_id,amount
HAVING SUM(amount)>20000


15. Find customers who have placed at least 2 completed orders. 
- SELECT customer_id, COUNT(order_id) 
FROM practorders
AS total_completed_id
WHERE status='completed' 
GROUP BY customer_id 
HAVING COUNT(order_id)>=2


