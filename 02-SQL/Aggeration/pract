CREATE TABLE orders (
    order_id SERIAL PRIMARY KEY,
    customer_id INT,
    product VARCHAR(50),
    category VARCHAR(50),
    amount NUMERIC(10,2),
    status VARCHAR(20),
    order_date DATE
);



