2. Foreign KEY:
-  value in one table that points to a record in another table.
ALTER TABLE stud
ADD CONSTRAINT fk_stud_course
FOREIGN KEY (id)
REFERENCES course(id);


UPDATE stud
SET course_id = 1
WHERE id = 1;




